DATABASE__DRIVER=postgresql+asyncpg
DATABASE__HOST=db
DATABASE__PORT=5432
DATABASE__USER=postgres
DATABASE__PASSWORD=postgres
DATABASE__NAME=topic_picker

AUTH__JWT_SECRET_KEY=change-me-please-32-characters-minimum
AUTH__JWT_ALGORITHM=HS256
AUTH__JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
AUTH__JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
AUTH__CONFIRMATION_TOKEN_LIFETIME_HOURS=24
AUTH__RESET_PASSWORD_TOKEN_LIFETIME_MINUTES=30

AUTH_BOOTSTRAP__ADMIN_EMAIL=admin@admin.com
AUTH_BOOTSTRAP__ADMIN_PASSWORD=admin123
AUTH_BOOTSTRAP__DEFAULT_USER_ROLE=public
AUTH_BOOTSTRAP__ADMIN_ROLE=admin

NOTIFICATIONS__FRONTEND_BASE_URL=http://localhost
WEB_PORT=80
